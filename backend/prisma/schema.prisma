generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())
}

model Project {
  id        String     @id @default(cuid())
  name      String
  createdAt DateTime   @default(now())
  entities  Entity[]
  relations Relation[]
}

model Entity {
  id        String   @id
  name      String
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])
  fields    Field[]
}

model Field {
  id       String  @id @default(cuid())
  name     String
  datatype String
  primary  Boolean @default(false)
  unique   Boolean @default(false)
  nullable Boolean @default(true)
  entityId String
  entity   Entity  @relation(fields: [entityId], references: [id])
}

model Relation {
  id        String  @id @default(cuid())
  from      String
  to        String
  type      String
  projectId String
  project   Project @relation(fields: [projectId], references: [id])
}
